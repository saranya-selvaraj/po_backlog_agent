{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "streamlit",
      "runtimeExecutable": "venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "streamlit",
        "run",
        "app/ui/streamlit_app.py",
        "--server.headless",
        "true",
        "--server.port",
        "8501",
        "--server.fileWatcherType",
        "none"
      ],
      "port": 8501
    }
  ]
}
